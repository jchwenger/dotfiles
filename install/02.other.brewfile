# vim: syntax=ruby ft=ruby

# compiler (Low Level Virtual Machine)
brew llvm # https://formulae.brew.sh/formula/llvm

# compression

brew xz
brew 7za
brew pigz # https://formulae.brew.sh/formula/pigz (https://zlib.net/pigz/)

# services

cask google-cloud-sdk # https://formulae.brew.sh/cask/google-cloud-sdk
brew awscli # https://formulae.brew.sh/formula/awscli
brew docker # https://formulae.brew.sh/formula/docker

# documents

# cask lyx # (latex editor) https://www.lyx.org/

# web

# brew httrack # https://www.httrack.com/

